// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Repository {
  id            String   @id @default(cuid())

  url           String  
  name          String
  commitSha     String?

  userId        String? // later we will be connecting it with USER

  jobs          ParsingJob[] @relation("RepositoryJobs")
  graph         Graph? @relation("RepositoryGraph")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Graph {
  id           String     @id @default(cuid())

  repositoryId String     @unique
  repository   Repository @relation("RepositoryGraph", fields: [repositoryId], references: [id], onDelete: Cascade)

  nodes GraphNode[]
  edges GraphEdge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GraphNode {
  id      String @id
  graphId String
  kind    String
  data    Json

  graph Graph @relation(fields: [graphId], references: [id], onDelete: Cascade)

  outgoingEdges GraphEdge[] @relation("GraphEdgeSource")
  incomingEdges GraphEdge[] @relation("GraphEdgeTarget")

  @@index([graphId])
  @@index([graphId, kind])
}

model GraphEdge {
  id               String @id
  graphId          String

  sourceId         String
  targetId         String
  relationshipKind String

  graph   Graph     @relation(fields: [graphId], references: [id], onDelete: Cascade)

  source  GraphNode @relation("GraphEdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)

  target  GraphNode @relation("GraphEdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([graphId])
  @@index([sourceId])
  @@index([targetId])
}


model ParsingJob {
  id            String   @id @default(cuid())

  repositoryId  String
  repository    Repository @relation("RepositoryJobs", fields: [repositoryId], references: [id])

  stage         ParsingStage
  status        JobStatus

  error         String?

  startedAt     DateTime?
  finishedAt    DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([repositoryId, createdAt])
  @@index([status])
}

enum ParsingStage {
  QUEUED
  CLONING
  DISCOVERING_FILES
  PARSING
  BUILDING_GRAPH
  ANALYZING
  COMPLETED
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}