// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String       @id @default(cuid())

  name      String
  email     String       @unique
  password  String

  repositories Repository[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Repository {
  id            String   @id @default(cuid())

  url           String  
  name          String
  commitSha     String?

  userId        String
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobs          ParsingJob[] @relation("RepositoryJobs")
  graph         Graph? @relation("RepositoryGraph")

  overview      RepositoryOverview?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, url])
}

model RepositoryOverview {
  id           String   @id @default(cuid())
  repositoryId String   @unique

  statistics   Json
  health       Json
  insights     Json

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Graph {
  id           String     @id @default(cuid())

  repositoryId String     @unique
  repository   Repository @relation("RepositoryGraph", fields: [repositoryId], references: [id], onDelete: Cascade)

  nodes GraphNode[]
  edges GraphEdge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GraphNode {
  id      String
  graphId String
  kind    String
  data    Json

  graph Graph @relation(fields: [graphId], references: [id], onDelete: Cascade)

  outgoingEdges GraphEdge[] @relation("GraphEdgeSource")
  incomingEdges GraphEdge[] @relation("GraphEdgeTarget")

  @@id([graphId, id])
  @@index([graphId])
  @@index([graphId, kind])
}

model GraphEdge {
  id               String
  graphId          String

  sourceId         String
  targetId         String
  relationshipKind String

  graph   Graph     @relation(fields: [graphId], references: [id], onDelete: Cascade)

  source GraphNode @relation("GraphEdgeSource", fields: [graphId, sourceId], references: [graphId, id], onDelete: Cascade)

  target GraphNode @relation("GraphEdgeTarget", fields: [graphId, targetId], references: [graphId, id], onDelete: Cascade)

  @@id([graphId, id])
  @@index([graphId])
  @@index([sourceId])
  @@index([targetId])
}


model ParsingJob {
  id            String   @id @default(cuid())

  repositoryId  String
  repository    Repository @relation("RepositoryJobs", fields: [repositoryId], references: [id])

  stage         ParsingStage
  status        JobStatus

  error         String?

  startedAt     DateTime?
  finishedAt    DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([repositoryId, createdAt])
  @@index([status])
}

enum ParsingStage {
  QUEUED
  CLONING
  DISCOVERING_FILES
  PARSING
  BUILDING_GRAPH
  ANALYZING
  COMPLETED
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}